# project-sandbox — do not commit agent secrets
.project-sandbox/
.devcontainer/
__pycache__/
*.pyc
.ruff_cache/
.venv/

# `uv build` output.
dist/
*.egg-info/

# results/ is deliberately NOT ignored: the generated tables of
# docs/findings.md are rendered from those files by
# src/internet_proxy_locally/report.py, so a checkout without them cannot
# re-derive or check the published comparison — only believe it.
.DS_Store

# state/ca/ is the mirror image of results/ above: the CA private key is
# generated once per checkout and trusted by that checkout's sandboxes
# specifically. Unlike config/*, it is never reviewed in a diff —
# committing it would make a private key a shared secret.
state/

# e2e release test log
e2e-release.log
