# TEST FIXTURE — what the dnsmasq container serves, read by
# data/images/dnsfixture/rebind.py from a read-only bind mount at
# /fixture/fixture.env.
#
# These four facts used to be baked into the image as build ARGs, which
# meant an already-built image kept serving the old ones after an edit to
# lab/fixtures.toml. Read at container start, they cannot go stale.
#
# `KEY=value`, one per line; `#` comments and blank lines are ignored.
# rebind.py refuses to start if any of them is missing or empty, because a
# fixture serving something other than what the checker probes for produces
# denials that look like enforcement and are really NXDOMAIN.

# The zone whose answers change between the first lookup and the next.
REBIND_ZONE={{ fixture.rebind_zone }}

# The public half of every first answer, and of the mixed-answer records.
PUBLIC_ANSWER={{ fixture.public_answer }}

# The reverse-DNS claim behind `ptr-allowlist`: this address answers PTR
# with this allowlisted hostname.
PTR_ADDRESS={{ fixture.ptr_address }}
PTR_CLAIMS={{ fixture.ptr_claims }}
