{% include "_banner.j2" %}
{% if test_policy %}
# TEST POLICY — NEVER use for normal operation. config/squid.conf plus the
# `[policy.test]` fixtures from config.toml. See docs/lab.md.
#
# Activate with:  ipl-lab --engine squid up
# Deactivate with `ipl up` (recreates with the real policy).
{% else %}
# Squid egress policy: default deny, hostname allowlist, IP-layer SSRF
# floors evaluated after DNS resolution. This is the Squid rendering of
# the shared logical policy in docs/policy.md; full rationale for every
# rule below is in docs/policy.md and docs/findings.md.
{% endif %}

# ---------------------------------------------------------------------------
# Listener
# ---------------------------------------------------------------------------

# TLS interception is opt-in (the `--tls-interception` CLI switch,
# docs/tls-interception.md). Off, this is a plain CONNECT tunnel — peeking
# the ClientHello without a signing CA crashes Squid the first time a
# peeked connection must be force-closed (docs/tls-interception.md,
# "Rejected: tunnel peeking without a CA"). On, Squid becomes the real TLS
# endpoint with a CA-backed `ssl_bump ... bump`, a structurally different
# mode from the rejected one.
{% if tls_interception %}
http_port 3128 ssl-bump tls-cert=/etc/squid/ca.pem tls-key=/etc/squid/ca-key.pem generate-host-certificates=on dynamic_cert_mem_cache_size=4MB
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/ssl_db -M 4MB
sslcrtd_children 8
{% else %}
http_port 3128
{% endif %}

{% if test_policy %}
# Lab origin trust only; system roots and hostname verification stay enabled.
tls_outgoing_options cafile=/fixture/ca.pem
# TTL-zero rebinding must cross the positive-cache floor during the probe.
negative_dns_ttl 1 seconds

{% endif %}
visible_hostname internet-proxy-locally
httpd_suppress_version_string on
# Client address stays internal. `via` is left at its RFC 9110 default.
forwarded_for delete

# ---------------------------------------------------------------------------
# No caching, no disk state
# ---------------------------------------------------------------------------
cache deny all
cache_store_log none
pid_filename none
logfile_rotate 0

access_log stdio:/dev/stdout squid
cache_log stdio:/dev/stderr

# Without this, every deny_info page below answers "Internal Error:
# Missing Template" — automatic localization never sees images/squid/errors.
error_directory /usr/share/squid/errors/en

# ---------------------------------------------------------------------------
# Request sanity
# ---------------------------------------------------------------------------
host_verify_strict on
dns_defnames off

# ---------------------------------------------------------------------------
# Deny floors (evaluated before any allow — http_access is first-match-wins)
# ---------------------------------------------------------------------------

acl CONNECT method CONNECT
acl TLS_ports port 443

# Address-form destinations, refused before any dstdomain rule can fall
# back to a reverse lookup. docs/findings.md ("a bare IP could satisfy
# the allowlist through a reverse lookup").
acl ip_literal dstdom_regex -i ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$
acl ip_literal dstdom_regex -i ^\[?[0-9a-f]*:[0-9a-f:.]*\]?$

# `dst` matches the *resolved* address, so a name that resolves private is
# still caught (docs/policy.md).
acl metadata_ip dst 169.254.169.254/32
acl metadata_ip dst fd00:ec2::254/128
acl metadata_ip dst 100.100.100.200/32

acl private_ip dst 0.0.0.0/8
acl private_ip dst 10.0.0.0/8
acl private_ip dst 100.64.0.0/10
acl private_ip dst 127.0.0.0/8
acl private_ip dst 169.254.0.0/16
acl private_ip dst 172.16.0.0/12
acl private_ip dst 192.0.0.0/24
acl private_ip dst 192.0.2.0/24
acl private_ip dst 192.88.99.0/24
acl private_ip dst 192.168.0.0/16
acl private_ip dst 198.18.0.0/15
acl private_ip dst 198.51.100.0/24
acl private_ip dst 203.0.113.0/24
acl private_ip dst 224.0.0.0/4
acl private_ip dst 240.0.0.0/4
acl private_ip dst ::/128
acl private_ip dst ::1/128
acl private_ip dst 64:ff9b::/96
acl private_ip dst 100::/64
acl private_ip dst 2001:db8::/32
acl private_ip dst fc00::/7
acl private_ip dst fe80::/10
acl private_ip dst ff00::/8

# Not part of the contract in README.md ("Stable interface").
http_access deny manager

# Metadata first: it is also link-local, and the more specific cause is
# the useful one to report.
http_access deny metadata_ip
http_access deny private_ip

# After the IP floors, so a private destination is attributed to SSRF
# rather than to its port.
http_access deny CONNECT !TLS_ports

# Before the allowlist, so a dstdomain rule never gets the chance to fall
# back to a PTR lookup for an address-form destination.
http_access deny ip_literal

# ---------------------------------------------------------------------------
# Allowlist
# ---------------------------------------------------------------------------

{% for domain in allow_exact %}
acl allowlist_exact dstdomain {{ domain }}
{% endfor %}

{% for domain in allow_wild %}
acl allowlist_wild dstdom_regex -i {{ domain | squid_wild }}
{% endfor %}
{% if test_policy %}

# --- [policy.test] in config.toml: adversarial fixtures only ---
{% for domain in allow_test_exact %}
acl allowlist_exact dstdomain {{ domain }}
{% endfor %}
{% for domain in allow_test_wild %}
acl allowlist_wild dstdom_regex -i {{ domain | squid_wild }}
{% endfor %}
{% endif %}

{% if allow_exact or allow_test_exact %}
http_access allow allowlist_exact
{% endif %}
{% if allow_wild or allow_test_wild %}
http_access allow allowlist_wild
{% endif %}

# ---------------------------------------------------------------------------
# Default deny
# ---------------------------------------------------------------------------
http_access deny all

# One page per cause, so a client — and the `checks.egress` classifier —
# can tell an allowlist refusal from an SSRF refusal without engine logs.
deny_info ERR_IPL_METADATA metadata_ip
deny_info ERR_IPL_PRIVATE_IP private_ip
deny_info ERR_IPL_PORT_NOT_ALLOWED TLS_ports
deny_info ERR_IPL_IP_LITERAL ip_literal
deny_info ERR_IPL_NOT_ALLOWLISTED all
{% if tls_interception %}
{% set bump_acls = (["allowlist_exact"] if allow_exact or allow_test_exact else []) + (["allowlist_wild"] if allow_wild or allow_test_wild else []) %}

# ---------------------------------------------------------------------------
# TLS interception (opt-in — see the note on http_port above)
# ---------------------------------------------------------------------------
#
# Only destinations the floors above would *allow* are peeked. Squid has to
# answer a CONNECT with `200` before the client will send the ClientHello it
# means to peek at, so anything peeked has already been told its tunnel is
# up: a denial reached afterwards can no longer deliver a `deny_info` page
# and can only abort the tunnel — `TCP_DENIED_ABORTED/200 … HIER_NONE/-` in
# Squid's own log. Policy holds either way (nothing is forwarded), but the
# refusal stops being legible to the caller.
#
# Gating the peek keeps that off the deny path entirely. A destination that
# fails the gate matches no ClientHello-requiring action at step1, so Squid
# never needs the early `200`, `http_access` decides it as it does in tunnel
# mode, and the caller gets a real 4xx with the page that names the cause.
# Bumping — and with it the inner-request enforcement interception is for —
# still covers every destination that is allowed to carry traffic.
#
# The gate is the http_access floors above, written positively; keep it in
# step with them. `peek step1` must always be paired with a `bump` over the
# same set: an orphaned peek with no bump is the crashing shape recorded in
# docs/tls-interception.md ("Rejected: tunnel peeking without a CA").
{% if bump_acls %}
acl step1 at_step SslBump1
acl bumpable any-of {{ bump_acls | join(" ") }}
ssl_bump peek step1 bumpable TLS_ports !metadata_ip !private_ip !ip_literal
ssl_bump bump bumpable TLS_ports !metadata_ip !private_ip !ip_literal
{% endif %}
# Everything else: an ordinary tunnel, refused by `http_access` above.
ssl_bump splice all
{% endif %}

# ---------------------------------------------------------------------------
# Not configured here
# ---------------------------------------------------------------------------
#
# `cache_peer` / any parent proxy — this proxy talks to origins directly.
# `auth_param` — v1 has one caller identity (docs/security.md).
