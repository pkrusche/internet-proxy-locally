{% include "_banner.j2" %}
{% if test_policy %}
# TEST POLICY — NEVER use for normal operation. config/pipelock.yaml plus
# the `[policy.test]` fixtures from data/lab/fixtures.toml. See docs/lab.md.
#
# Activate with:  ipl-lab --engine pipelock up
# Deactivate with `ipl up` (recreates with the real policy).
{% else %}
# Pipelock configuration: strict standard forward proxy, default deny.
# This is the Pipelock rendering of the shared logical policy in
# docs/policy.md.
#
# MCP / A2A / fetch-API features of Pipelock are intentionally unused.
# TLS interception stays disabled for v1 (docs/security.md, "Non-goals").
{% endif %}

version: 1
mode: strict
enforce: true

api_allowlist:
{% for domain in allow %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% if test_policy %}
  # --- [policy.test] in data/lab/fixtures.toml: adversarial fixtures only ---
{% for domain in allow_test %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% endif %}

forward_proxy:
  enabled: true
  # CONNECT target must match the TLS ClientHello SNI (blocks domain fronting).
  sni_verification: true
  # Bytes inside a CONNECT tunnel must be TLS (blocks raw protocol smuggling).
  sni_require_tls: true

tls_interception:
  enabled: false
