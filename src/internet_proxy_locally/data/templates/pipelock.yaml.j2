{% include "_banner.j2" %}
{% if test_policy %}
# TEST POLICY — NEVER use for normal operation. config/pipelock.yaml plus
# the `[policy.test]` fixtures from config.toml. See docs/lab.md.
#
# Activate with:  ipl-lab --engine pipelock up
# Deactivate with `ipl up` (recreates with the real policy).
{% else %}
# Pipelock configuration: strict standard forward proxy, default deny.
# This is the Pipelock rendering of the shared logical policy in
# docs/policy.md.
#
# MCP / A2A / fetch-API features of Pipelock are intentionally unused.
# TLS interception is opt-in — see docs/tls-interception.md and
# the `--tls-interception` CLI switch.
{% endif %}

version: 1
mode: strict
enforce: true

api_allowlist:
{% for domain in allow %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% if test_policy %}
  # --- [policy.test] in config.toml: adversarial fixtures only ---
{% for domain in allow_test %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% endif %}

forward_proxy:
  enabled: true
  # CONNECT target must match the TLS ClientHello SNI (blocks domain fronting).
  sni_verification: true
  # Bytes inside a CONNECT tunnel must be TLS (blocks raw protocol smuggling).
  sni_require_tls: true

{% if tls_interception %}
tls_interception:
  enabled: true
  ca_cert: "/config/ca.pem"
  ca_key: "/config/ca-key.pem"
  max_response_bytes: 5242880
{% else %}
tls_interception:
  enabled: false
{% endif %}
