{% include "_banner.j2" %}
{% if test_policy %}
# TEST POLICY — NEVER use for normal operation. config/smokescreen.yaml
# plus the `[policy.test]` fixtures from config.toml. See docs/lab.md.
#
# Activate with:  ipl-lab --engine smokescreen up
# Deactivate with `ipl up` (recreates with the real policy).
{% else %}
# Smokescreen egress ACL: default deny, enforce mode. This is the
# Smokescreen rendering of the shared logical policy in docs/policy.md.
#
# Requests carry no role (no client TLS cert in v1), so every request
# falls through to the `default` service below — see
# `allow_missing_role: true` in config/smokescreen.conf.yaml. Private/
# loopback/link-local blocking is built into Smokescreen and is NOT
# disabled here (never pass --unsafe-allow-private-ranges).
{% endif %}

---
version: v1

services: []

default:
  name: default
  project: internet-proxy-locally
  action: enforce
  allowed_domains:
{% for domain in allow %}
    - {{ domain | yaml_scalar }}
{% endfor %}
{% if test_policy %}
    # --- [policy.test] in config.toml: adversarial fixtures only ---
{% for domain in allow_test %}
    - {{ domain | yaml_scalar }}
{% endfor %}
{% endif %}
