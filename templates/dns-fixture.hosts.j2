{% include "_banner.j2" %}
# TEST FIXTURE — served by the dnsmasq container that
# `./run.py up --test-policy` starts, and read only through it. Never
# present in normal operation.
#
# Source of truth: `[fixture.records]` in config.toml. Full rationale for
# what this fixture is for and why it has to be a local dnsmasq container
# rather than a bind-mounted `/etc/hosts`: docs/policy.md ("The fixture
# records") and docs/security.md ("The local DNS fixture").
#
# `{{ fixture.rebind_zone }}` is NOT here: its answers change between the
# first lookup and the next, which no static file can express, so
# images/dnsfixture/rebind.py serves that zone instead.
{% for record in fixture_records %}

{% if record.role == "control" %}
# Control: one public address, nothing else — must be reachable through
# the proxy or the mixed-answer rows below cannot be attributed.
{% else %}
{% if loop.first or fixture_records[loop.index0 - 1].role == "control" %}
# Mixed answers, both orderings (docs/engines.md, "Mixed DNS answers").
#
{% endif %}
# {{ record.shape }}.
{% endif %}
{% for address in record.addresses %}
{{ "%-15s"|format(address) }} {{ record.name }}
{% endfor %}
{% endfor %}
