{% include "_banner.j2" %}
{% if test_policy %}
# TEST POLICY — NEVER use for normal operation.
#
# config/pipelock.yaml plus the `[policy.test]` entries from config.toml:
# wildcard DNS services and the names the local DNS fixture serves
# (services/dnsfixture.toml). All of them resolve to arbitrary,
# attacker-chosen IPs. Allowlisting them is the point of the test: with
# the hostname allowed, the proxy's *IP-layer* SSRF floors (private,
# loopback, link-local, metadata, DNS rebinding) must still block the
# connection. See checks/egress.py and docs/security.md.
#
# Activate with:  ./run.py --engine pipelock up --test-policy
# Deactivate with a normal `./run.py up` (recreates with the real policy).
{% else %}
# Pipelock configuration: strict standard forward proxy, default deny.
#
# This file is the Pipelock expression of the shared logical policy in
# docs/policy.md. The allowlist below comes from config.toml and is
# rendered identically into every engine's config, so the three cannot
# drift apart.
#
# Notes:
# - MCP / A2A / fetch-API features of Pipelock are intentionally unused.
# - TLS interception stays disabled for v1 (docs/pipelock.md).
# - Validate keys against the pinned release (services/pipelock.toml)
#   after any upgrade: `./run.py setup && ./run.py check --quick`.
{% endif %}

version: 1
mode: strict
enforce: true

api_allowlist:
{% for domain in allow %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% if test_policy %}
  # --- [policy.test] in config.toml: adversarial fixtures only ---
{% for domain in allow_test %}
  - {{ domain | yaml_scalar }}
{% endfor %}
{% endif %}

forward_proxy:
  enabled: true
  # CONNECT target must match the TLS ClientHello SNI (blocks domain fronting).
  sni_verification: true
  # Bytes inside a CONNECT tunnel must be TLS (blocks raw protocol smuggling).
  sni_require_tls: true

tls_interception:
  enabled: false
